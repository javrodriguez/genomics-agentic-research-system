{
  "definitions": {
    "comparisons": [
      "for each enforced task, the set of models that hold it",
      "for each silent task, the set of models that cover it"
    ],
    "covers_the_gap": "holds a task whose `layer.observed_for_probed_behaviour` is exactly `silent`. That field is the VERDICT and takes one of three fixed values (enforced, silent, not established); `layer.probed_behaviour` names which behaviour the verdict is about. An earlier draft pointed this definition at the behaviour field and left the verdict unconstrained, so the study's central count turned on a string comparison nobody had pre-registered.",
    "holds": "every one of the n graded takes carries the correct label on BOTH halves. Anything less is printed as the counts with no verb.",
    "no_rates": "No percentage sign, and no solidus fraction of two numbers. The SPELLED form `k of n` is the study's own prescribed shape and is permitted everywhere -- the analysis plan, the protocol and the published table all use it. The rule exists to stop n = 3 being dressed up as a rate, not to forbid counting. Enforced by lint_language.py, whose `ratio-slash` pattern matches the solidus form only. The forbidden shape is deliberately not written out here: this file is scanned by that guard, and a rule that names its own violation trips it.",
    "per_task": "the layer verdict with its negative-control output or the reviewer's ruling; then per model, k of n correct on the positive half and k of n on the control half",
    "predictions_beside_outcomes": "two columns, blind and informed, right or wrong",
    "round_1_beside_round_2": {
      "heading": "The instruments differ: round 1's counts are printed beside round 2's, not pooled",
      "tasks": [
        "scope-read",
        "plan-gate"
      ],
      "what": "for each model, round 1's published k of n per half beside round 2's, under that heading, with no sentence comparing them"
    }
  },
