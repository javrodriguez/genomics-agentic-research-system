# Project working data never belongs in the repo
gars/projects/*/
!gars/projects/.gitkeep

# Stage outputs and pipeline artifacts
**/00_data/*/raw/*
!**/00_data/*/raw/.gitkeep
**/run/
**/run.crashed-*/
**/run.failed-*/
**/work/
.nextflow*
*.sif

# Slurm
*.out
*.err
STATUS
submit.sh

# Third-party skills are installed with clawbio, never vendored. Guard against re-introduction.
# NOTE: gars/_system/wrappers/ is deliberately NOT ignored -- GARS-authored wrappers are versioned
# here and are ours to maintain (decision 0012). wrappers/ is not skills/, and that is the point.
gars/_system/skills/
gars/tools/

# Third-party skill bundles kept locally for reference, not part of GARS
skills_dev/

# Workspace copies and clones made INSIDE the repo directory. `gars/` is a template that gets
# copied; when the copy lands here it is a working area, never repo content -- and it usually
# carries its own .git, which `git add -A` turns into a broken submodule pointer.
#
# This matters more than tidiness. A workspace holds real projects, and a project's samples.csv
# carries patient-derived sample IDs. This repository is public and its own rule is that such IDs
# never enter it. One `git add -A` in the wrong directory publishes them.
#
# Keep workspaces OUTSIDE the repo. These patterns are the backstop for when they are not, and
# they cannot cover a name nobody has thought of yet -- so if you put a workspace in here, add it
# to this list in the same breath.
gars-test*/
gars-workspace*/
genomics-agentic-research-system/
*_prj/
*_project/
*workspace*/

# Written by upgrade.py inside a live workspace; the template in this repo has no origin to record.
.gars-workspace

.DS_Store
__pycache__/
*.pyc
