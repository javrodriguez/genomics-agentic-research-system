# Project working data never belongs in the repo
gars/projects/*/
!gars/projects/.gitkeep

# Stage outputs and pipeline artifacts
**/00_data/*/raw/*
!**/00_data/*/raw/.gitkeep
**/run/
**/run.crashed-*/
**/run.failed-*/
**/work/
.nextflow*
*.sif

# Slurm
*.out
*.err
STATUS
submit.sh

# Skills are installed with clawbio, never vendored. Guard against re-introduction.
gars/tools/skills/

.DS_Store
__pycache__/
*.pyc
