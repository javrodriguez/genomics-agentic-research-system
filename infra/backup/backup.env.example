# Trusted operator environment: copy outside git, chmod 600, fill, set -a; source; set +a.
# Placeholders only. Database credentials are NEVER literal environment values here.
PGHOST='<source-endpoint>'
PGPORT='<source-port>'
PGUSER='<backup-role>'
PGDATABASE='<source-database>'
PGPASSFILE='<absolute-passfile>'
# Client tools inside postgres:16, never the host's older pg_dump.
PG_CLIENT_MODE=container
CONTAINER_ENGINE=docker
COMPOSE_PROJECT='<compose-project>'
PG_PASSWORD_FILE='<absolute-compose-secret-file>'
PG_DATA_DIR='<absolute-postgres-data-directory>'
PG_BIND_ADDR='<loopback-or-tailnet-bind-address>'
PG_PORT='<published-port>'
PG_RESTART=unless-stopped
COMPOSE_VOLUME_SUFFIX=''
BACKUP_LOCAL_DIR='<absolute-backup-directory-outside-git>'
BACKUP_WORK_DIR='<absolute-private-child-of-backup-directory>'
BACKUP_OFFMACHINE_DEST='<user>@<tailnet-destination>:<absolute-directory>'
# Optional until the row-8 data-handling decision permits a second destination (R-136).
BACKUP_SECOND_DEST=''
ENC_TOOL=auto
# gpg: passphrase file; age: recipients file. Neither may be inside a git work tree.
ENC_KEY_FILE='<absolute-encryption-key-file>'
# age requires its identity file; gpg uses the same passphrase file for encryption/decryption.
ENC_IDENTITY_FILE='<absolute-decryption-identity-file>'
RETENTION_COUNT=14
# Newline-separated absolute files/directories. Brain-owned glitch-main copy, R-126.
EXTRA_PATHS=''
# Independent person/session supplies the CSV before destruction; scripts never author it.
DRILL_CANARY_FILE='<absolute-independent-canary-file>'
DRILL_TARGET_PGHOST='<recovery-endpoint>'
DRILL_TARGET_PGPORT='<recovery-port>'
DRILL_TARGET_PGUSER='<recovery-role>'
DRILL_TARGET_PGDATABASE='<distinct-marked-recovery-database>'
# Explicit logs; tests always override to scratch. Commit evidence only after human review.
RESTORE_LOG='<absolute-restore-log>'
EXPOSURE_PUBLIC_HOST='<public-endpoint>'
EXPOSURE_TAILNET_HOST='<tailnet-endpoint>'
EXPOSURE_PORTS='5432 6379 8006 2375 22'
EXPOSURE_CONTROL_HOST='<third-host-with-known-open-port>'
EXPOSURE_CONTROL_PORT=443
EXPOSURE_LOG='<absolute-exposure-log>'
# Parsed as argv, not shell; default when unset is curl -s https://ifconfig.me.
SOURCE_IP_CMD='curl -s https://ifconfig.me'
