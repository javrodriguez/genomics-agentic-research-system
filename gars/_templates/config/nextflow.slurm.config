// Executor settings, passed to the wrapper via --nextflow-config.
//
// Required, not optional: Nextflow detects Slurm and submits each pipeline process as its own
// child job. The partition chosen for the parent job does not apply to them, so without an
// explicit queue they land wherever Nextflow defaults -- in our case the most contended
// partition on the cluster.
//
// Must define no `params` in any form; the wrapper rejects such configs so its audited
// parameter surface cannot be bypassed. Executor and process settings are the permitted use.

process {
    executor = 'slurm'
    queue    = 'cpu_long'

    // 130..145 covers the SIGTERM/SIGKILL family; 104 is a common transient.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
}

executor {
    queueSize       = 20
    submitRateLimit = '10/1min'
}

// OCI->SIF conversion budget. The default 20m is calibrated for biocontainers-sized
// images; the multi-tool wave containers some pipelines declare (spatialvi's
// harmonypy+scanorama image, for one) convert for longer than that on shared GPFS, and
// the pull is then killed AFTER the download at the conversion step -- a 25-minute run
// that dies with "status: 143" and its own hint naming this setting. Seen live on the
// first tierb-spatial run, 2026-08-30. A too-long timeout costs nothing when images are
// cached; a too-short one costs the whole first run of any assay with a fat container.
apptainer.pullTimeout = '90m'
