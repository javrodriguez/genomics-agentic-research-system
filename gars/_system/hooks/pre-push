#!/usr/bin/env python3
"""R-164 whole-suite gate; any pre-existing hook keeps its stdin and veto."""
import os
import hashlib
import json
import re
import runpy
import subprocess
import sys
from pathlib import Path

MARKER = 'GARS_ROW3_PRE_PUSH_V1'


ACTIVATION_RECORD = 'docs/decisions/0120-row-14-evaluator-smoke-delta-bench-gate.md'

# R-165 row 14: the evaluator of a Bench smoke record, pinned by sha256 at the repository root.
# Changing either file is a protected change that must update this pin (evals/smoke/SMOKE.md).
TRUSTED_EVALUATOR = {
    'evals/bench.py': '27888b8b73748628052b62375ff1eb3c54cead906f028f0d663f06681e948755',
    'evals/smoke/smoke.py': '60b4ed364169b435861e3c20cbe1c42e2005da8a04cbb0c6c4a861fb5acd6c87',
}


def git_bytes(root, *args, **kwargs):
    # Object identities must resolve to stored bytes, never local replacements.
    return subprocess.check_output(['git', '--no-replace-objects'] + list(args), cwd=str(root),
                                   stderr=subprocess.PIPE, timeout=60, **kwargs)


def required_trailers(root, commit):
    """Only Git's final trailer block counts; duplicate required keys refuse."""
    message = git_bytes(root, 'show', '-s', '--format=%B', commit)
    parsed = git_bytes(root, 'interpret-trailers', '--parse', input=message).decode('utf-8')
    trailers = {}
    for line in parsed.splitlines():
        key, value = line.split(':', 1)
        if key.lower() in ('review', 'bench', 'session'):
            key = key.lower()
            if key in trailers or not value.strip():
                raise ValueError('duplicate or empty ' + key + ' trailer')
            trailers[key] = value.strip()
    if set(trailers) != {'review', 'bench', 'session'}:
        raise ValueError('missing Review, Bench or Session trailer')
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.:-]*', trailers['session']):
        raise ValueError('invalid Session id')
    return trailers


def review_session(content, committing_session):
    sessions = re.findall(r'^session:[ \t]*([^\r\n]+)', content, re.M | re.I)
    if len(sessions) != 1:
        raise ValueError('review requires exactly one session: line')
    session = sessions[0].strip()
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.:-]*', session):
        raise ValueError('invalid review session id')
    if session == committing_session:
        raise ValueError('review session equals committing Session')
    return session


def load_evaluator(root):
    """Pin check first; the evaluator runs from the repository root, never from evidence."""
    for name, expected in sorted(TRUSTED_EVALUATOR.items()):
        path = Path(root) / name
        if (path.is_symlink() or not path.is_file() or
                hashlib.sha256(path.read_bytes()).hexdigest() != expected):
            raise ValueError('untrusted evaluator: %s absent or differs from TRUSTED_EVALUATOR' % name)
    return runpy.run_path(str(Path(root) / 'evals/smoke/smoke.py'))['evaluate']


def first_parent(root, commit):
    parents = git_bytes(root, 'show', '-s', '--format=%P', commit).decode('ascii').split()
    return parents[0] if parents else None


def tree_reader(root, commit):
    """Regular blobs of the bound commit's own tree (task contracts, inputs, RESPONSE.md)."""
    def read_tree(name):
        if (not name or name.startswith('/') or '\\' in name or ':' in name or
                any(part in ('', '.', '..') for part in name.split('/')) or
                any(ord(char) < 32 for char in name)):
            raise ValueError('tree read requires a repository-relative file path')
        entries = [entry for entry in git_bytes(root, 'ls-tree', '-z', commit, '--',
                                                ':(literal)' + name).split(b'\0') if entry]
        if len(entries) != 1:
            raise ValueError('file absent from the bound commit: ' + name)
        metadata, path = entries[0].split(b'\t', 1)
        mode, kind, oid = metadata.decode('ascii').split()
        if path.decode('utf-8') != name or mode not in ('100644', '100755') or kind != 'blob':
            raise ValueError('bound tree entry must be a regular file: ' + name)
        return git_bytes(root, 'cat-file', 'blob', oid)

    return read_tree


def validate_evidence(root, commit, read_record, expect_previous):
    """The reader supplies repository-contained records; never execute evidence."""
    trailers = required_trailers(root, commit)
    review_session(read_record(trailers['review']), trailers['session'])
    if not trailers['bench'].startswith('evals/runs/smoke/'):
        raise ValueError('Bench must name an evals/runs/smoke/ record; n/a forbidden for _system changes')
    record = read_record(trailers['bench'])
    evaluate = load_evaluator(root)
    verdict = evaluate(record, read_record, tree_reader(root, commit), commit,
                       first_parent(root, commit) or '', expect_previous,
                       record_path=trailers['bench'])
    if verdict['ok'] is not True:
        raise ValueError('Bench smoke record refused: ' + '; '.join(
            '%s %s' % (finding['code'], finding['field']) for finding in verdict['findings']))


def first_parent_chain(root, tip):
    return git_bytes(root, 'rev-list', '--first-parent', tip).decode('ascii').split()


def activation_of(root, tip):
    """Earliest first-parent commit whose tree holds the record while its first parent's does not."""
    chain = first_parent_chain(root, tip)
    query = ''.join('%s:%s\n' % (commit, ACTIVATION_RECORD) for commit in chain).encode('ascii')
    lines = git_bytes(root, 'cat-file', '--batch-check', input=query).decode('ascii').splitlines()
    if len(lines) != len(chain):
        raise ValueError('cannot establish trailer activation')
    present = [line.split()[1] == 'blob' for line in lines]
    for index in range(len(chain) - 1, -1, -1):
        if present[index] and not (index + 1 < len(chain) and present[index + 1]):
            return chain[index]
    return None


def touches_system(root, commit):
    parent = first_parent(root, commit)
    base = [parent, commit] if parent else ['--root', commit]
    paths = git_bytes(root, 'diff-tree', '-r', '--no-commit-id', '--name-only', '--no-renames',
                      '-z', *base).decode('utf-8').split('\0')
    return any('_system' in Path(path).parts[:-1] for path in paths if path)


def previous_bench(root, commit):
    """Bench path of the nearest earlier checked first-parent commit since activation, or None."""
    activation = activation_of(root, commit)
    if activation is None or activation == commit:
        return None
    chain = first_parent_chain(root, commit)
    for earlier in chain[1:chain.index(activation) + 1]:
        if touches_system(root, earlier):
            return required_trailers(root, earlier)['bench']
    return None


def pushed_commits(root, payload):
    groups = []
    for line in payload.decode('ascii').splitlines():
        fields = line.split()
        if len(fields) != 4:
            raise ValueError('invalid pre-push stdin')
        unused_local_ref, local, unused_remote_ref, remote = fields
        if not all(re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', oid) for oid in (local, remote)):
            raise ValueError('invalid push object ID')
        if set(local) == {'0'}:
            continue
        for oid in (local, remote):
            if set(oid) != {'0'}:
                git_bytes(root, 'rev-parse', '--verify', oid + '^{commit}')
        revision = [local] if set(remote) == {'0'} else ['^' + remote, local]
        groups.append((local, git_bytes(root, 'rev-list', '--first-parent',
                                        *revision).decode('ascii').split()))
    if not any(commits for unused_local, commits in groups):
        return []
    if git_bytes(root, 'rev-parse', '--is-shallow-repository').strip() != b'false':
        raise ValueError('shallow history cannot establish trailer activation')
    # Main's first-parent line is the checked unit: a merge carries its branch's evidence.
    # Activation is the earliest first-parent commit that adds the record, so deleting or
    # re-adding it at a later tip cannot move the boundary; its first parent's history is exempt.
    result = []
    for local, commits in groups:
        activation = activation_of(root, local)
        if activation is None:
            continue  # History predates adoption of this record/hook.
        parent = first_parent(root, activation)
        exempt = set(git_bytes(root, 'rev-list', parent).decode('ascii').split()) if parent else set()
        for commit in reversed(commits):
            if commit not in exempt and commit not in result:
                result.append(commit)
    return result


def committed_reader(root, commit, snapshot):
    """Read regular blobs from a strictly later outgoing committed snapshot."""
    snapshot = git_bytes(root, 'rev-parse', '--verify', snapshot + '^{commit}').decode('ascii').strip()
    if snapshot == commit:
        raise ValueError('later committed evidence snapshot required; self-reference refused')
    git_bytes(root, 'merge-base', '--is-ancestor', commit, snapshot)

    def read_record(name):
        # Reject revision syntax, traversal, pathspec magic and nonregular blobs.
        if (not name or name.startswith('/') or '\\' in name or ':' in name or
                any(part in ('', '.', '..') for part in name.split('/')) or
                any(ord(char) < 32 for char in name)):
            raise ValueError('evidence requires a repository-relative file path')
        entries = git_bytes(root, 'ls-tree', '-z', snapshot, '--', ':(literal)' + name).split(b'\0')
        entries = [entry for entry in entries if entry]
        if len(entries) != 1:
            raise ValueError('evidence file absent from committed snapshot')
        metadata, path = entries[0].split(b'\t', 1)
        mode, kind, oid = metadata.decode('ascii').split()
        if path.decode('utf-8') != name or mode not in ('100644', '100755') or kind != 'blob':
            raise ValueError('evidence must be a regular committed file')
        return git_bytes(root, 'cat-file', 'blob', oid).decode('utf-8')

    read_record.listing = lambda prefix: committed_listing(root, snapshot, prefix)
    return read_record


def committed_listing(root, snapshot, prefix):
    """Every entry of the snapshot below a folder, relative to it (missing or extra files)."""
    folder = prefix.rstrip('/')
    names = git_bytes(root, 'ls-tree', '-r', '-z', '--name-only', snapshot, '--',
                      ':(literal)' + folder).decode('utf-8').split('\0')
    return sorted(name[len(folder) + 1:] for name in names if name.startswith(folder + '/'))


def trailer_gate(root, payload, read_record=None):
    try:
        checked = 0
        # Each outgoing ref supplies its own immutable snapshot, including when
        # HEAD is detached or another branch is checked out. Never read worktree evidence.
        groups = [payload] if read_record is not None else payload.splitlines()
        for group in groups:
            commits = pushed_commits(root, group)
            for commit in commits:
                # The diff against the FIRST parent decides; --root for a root commit.
                if not touches_system(root, commit):
                    continue
                reader = read_record
                if reader is None:
                    snapshot = group.decode('ascii').split()[1]
                    reader = committed_reader(root, commit, snapshot)
                validate_evidence(root, commit, reader, previous_bench(root, commit))
                checked += 1
        print('trailers: %d _system commits checked' % checked)
        return True
    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError) as exc:
        reason = str(exc) if isinstance(exc, ValueError) else 'cannot read trailer evidence/history'
        print('trailers: REFUSED (%s)' % reason, file=sys.stderr)
        return False


def main():
    payload = sys.stdin.buffer.read()
    root = subprocess.check_output(['git', 'rev-parse', '--show-toplevel']).decode().strip()
    previous = Path(__file__).absolute().with_name('pre-push.gars-previous')
    failed = False
    if previous.exists() or previous.is_symlink():
        try:
            # Each command gets a fresh copy; a gitleaks hook may consume every input byte.
            code = subprocess.run([str(previous)] + sys.argv[1:], cwd=root,
                                  input=payload).returncode
            failed = code != 0
        except OSError as exc:
            print('pre-push: previous hook could not run: %s' % exc, file=sys.stderr)
            failed = True
    try:
        scanner = runpy.run_path(str(Path(__file__).with_name('pre-commit')))['scan']
        clean = scanner(root, payload, push=True)
        failed = failed or not clean
    except Exception as exc:
        print('pre-push: gitleaks gate could not run: %s' % exc, file=sys.stderr)
        failed = True
    try:
        trailers = trailer_gate(root, payload)
        failed = failed or not trailers
    except Exception:
        print('pre-push: trailer gate could not run', file=sys.stderr)
        failed = True
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1')
    try:
        code = subprocess.run([sys.executable, 'tests/run_tests.py'], cwd=root,
                              input=payload, env=env).returncode
        failed = failed or code != 0
    except OSError as exc:
        print('pre-push: suite could not run: %s' % exc, file=sys.stderr)
        failed = True
    print('pre-push: REFUSED' if failed else 'pre-push: whole suite passed')
    return 1 if failed else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError) as exc:
        print('pre-push: REFUSED (%s)' % exc, file=sys.stderr)
        sys.exit(1)
