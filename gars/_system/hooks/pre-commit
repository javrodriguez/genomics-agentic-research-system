#!/usr/bin/env python3
"""R-096 staged secrets gate and shared scanner; previous hooks retain their veto."""
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

MARKER = 'GARS_ROW15_PRE_COMMIT_V1'
SCAN_TIMEOUT = 60
CONFIG = 'gars/.gitleaks.toml'


def scan(root, payload=b'', push=False):
    """No bypass setting. Explicit repo config, bounded scan, classified exit codes."""
    try:
        root = Path(root).resolve()
        config = (root / CONFIG).resolve()
        try:
            config.relative_to(root)
        except ValueError:
            raise RuntimeError('gitleaks config resolves outside repository')
        try:
            config.read_bytes()
        except OSError:
            raise RuntimeError('gitleaks config is unreadable')
        binary = shutil.which('gitleaks')
        if binary is None:
            raise RuntimeError('gitleaks absent from PATH')
        ranges = [None]
        if push:
            ranges = []
            for line in payload.decode('ascii').splitlines():
                fields = line.split()
                if len(fields) != 4:
                    raise RuntimeError('invalid pre-push stdin')
                local_ref, local, remote_ref, remote = fields
                if not all(re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', s)
                           for s in (local, remote)):
                    raise RuntimeError('invalid pre-push object ID')
                if set(local) == {'0'}:  # deletion sends no objects
                    continue
                for oid in (local, remote):
                    if set(oid) != {'0'}:
                        subprocess.check_output(['git', 'rev-parse', '--verify',
                                                 oid + '^{commit}'], cwd=str(root),
                                                stderr=subprocess.PIPE)
                # A new remote ref is scanned through all its reachable history.
                ranges.append(local if set(remote) == {'0'} else remote + '..' + local)
        env = {k: v for k, v in os.environ.items() if not k.startswith('GITLEAKS_')}
        with tempfile.TemporaryDirectory(prefix='gars-gitleaks-') as temporary:
            ignore = Path(temporary) / 'empty-ignore'
            ignore.write_bytes(b'')
            for revision in ranges:
                # Git omits binary/-diff contents from patches. Refuse these
                # inputs rather than claim that a partial textual scan is clean.
                # --no-renames keeps each NUL-delimited numstat record independent.
                stat_args = (['log', '--format=', '--root', '-m', revision] if push else
                             ['diff', '--cached'])
                stats = subprocess.check_output(
                    ['git'] + stat_args + ['--numstat', '-z', '--no-renames',
                                          '--no-ext-diff', '--no-textconv'],
                    cwd=str(root), stderr=subprocess.PIPE, timeout=SCAN_TIMEOUT)
                for record in stats.split(b'\0'):
                    counts = record.lstrip(b'\n').split(b'\t', 2)
                    if len(counts) == 3 and b'-' in counts[:2]:
                        raise RuntimeError('gitleaks cannot scan binary or -diff content completely')
                argv = [binary, 'git', str(root), '--config', str(config),
                        '--redact=100', '--no-banner', '--no-color',
                        '--ignore-gitleaks-allow', '--gitleaks-ignore-path', str(ignore),
                        '--max-decode-depth=5', '--exit-code=42']
                argv += (['--log-opts=' + revision] if push else
                         ['--pre-commit', '--staged'])
                result = subprocess.run(argv, cwd=str(root), env=env,
                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                        timeout=SCAN_TIMEOUT)
                if result.returncode == 42:
                    raise RuntimeError('gitleaks found secrets')
                if result.returncode != 0:
                    raise RuntimeError('gitleaks unclassified exit %s' % result.returncode)
        print('gitleaks: passed')
        return True
    except subprocess.TimeoutExpired:
        reason = 'gitleaks timeout'
    except (OSError, RuntimeError, UnicodeError, subprocess.CalledProcessError) as exc:
        reason = str(exc) if isinstance(exc, RuntimeError) else 'gitleaks could not complete scan'
    print('gitleaks: REFUSED (%s)' % reason, file=sys.stderr)
    return False


# Owner rulings 7A/8A: singular/plural words, legacy frontmatter, append-only log.
RECORD_DATE = '2026-09-22'
CITATION = re.compile(r'\bdecisions?\s+(\d{4})\b', re.I)


def git_bytes(root, *args):
    # Object identities must resolve to stored bytes, never local replacements.
    return subprocess.check_output(['git', '--no-replace-objects'] + list(args), cwd=str(root),
                                   stderr=subprocess.PIPE, timeout=60)


def citation_path(name):
    p = Path(name)
    return (not name.startswith('docs/specs/') and
            (p.suffix in ('.py', '.sh', '.yml', '.yaml', '.toml') or
             p.name == '.gitignore' or (name.startswith('gars/') and p.suffix == '.md')))


def record_fields(text):
    """Read the house scalar frontmatter without introducing a YAML dependency."""
    import datetime
    match = re.match(r'\A---\r?\n(.*?)\r?\n---(?:\r?\n|$)', text, re.S)
    if not match:
        raise ValueError('record frontmatter missing')
    fields = {}
    for key in ('date', 'status'):
        values = re.findall(r'^' + key + r':\s*([^\r\n]+)', match.group(1), re.M)
        if len(values) != 1:
            raise ValueError('record requires one frontmatter ' + key)
        fields[key] = values[0].split(' #', 1)[0].strip().strip('\'"')
    datetime.datetime.strptime(fields['date'], '%Y-%m-%d')
    if fields['status'] not in ('standing', 'superseded'):
        raise ValueError('record status invalid')
    if fields['date'] >= RECORD_DATE:
        sections = dict((m.group(1), m.group(2).strip()) for m in re.finditer(
            r'^## ([^\n]+)\n(.*?)(?=^## |\Z)', text, re.M | re.S))
        # The spec and the existing house record also spell Test this way.
        if 'Test-that-proves-it' in sections:
            sections.setdefault('Test', sections['Test-that-proves-it'])
        for key in ('Context', 'Decision', 'Test', 'Status', 'Date'):
            if not sections.get(key):
                raise ValueError('new record missing ' + key)
    return fields


def decision_links(root, staged=False):
    """Same acceptance over tracked working bytes or index blobs; no worktree fallback."""
    total = resolved = 0
    errors = []
    try:
        root = Path(root)
        folder = root / 'docs/decisions'
        if (folder.is_symlink() or not folder.is_dir() or
                root.resolve() not in folder.resolve().parents or
                not folder.stat().st_mode & 0o444 or not folder.stat().st_mode & 0o111):
            raise ValueError('unreadable decisions folder')
        list(folder.iterdir())  # Detect actual permission/I/O errors as well as mode bits.
        entries = {}
        for entry in git_bytes(root, 'ls-files', '--stage', '-z').split(b'\0'):
            if not entry:
                continue
            meta, name = entry.split(b'\t', 1)
            mode, oid, stage = meta.decode('ascii').split()
            name = name.decode('utf-8')
            if stage != '0':
                raise ValueError('unmerged index')
            entries[name] = (mode, oid)

        def read(name):
            mode, oid = entries[name]
            if mode not in ('100644', '100755'):
                raise ValueError('nonregular citation input: ' + name)
            if staged:
                return git_bytes(root, 'cat-file', 'blob', oid).decode('utf-8')
            path = root / name
            if path.is_symlink() or root.resolve() not in path.resolve().parents:
                raise ValueError('citation input escapes repository')
            return path.read_text(encoding='utf-8')

        records = {}
        for name in sorted(entries):
            match = re.fullmatch(r'docs/decisions/(\d{4})-[^/]+\.md', name)
            if match:
                number = match.group(1)
                if number in records:
                    raise ValueError('duplicate decision number: ' + number)
                records[number] = name
                try:
                    record_fields(read(name))
                except ValueError as exc:
                    errors.append(name + ': ' + str(exc))
        if not records:
            raise ValueError('unreadable decisions folder: no indexed records')
        for name in sorted(entries):
            if citation_path(name):
                for number in CITATION.findall(read(name)):
                    total += 1
                    if number in records:
                        resolved += 1
                    else:
                        errors.append(name + ': dangling decision ' + number)
    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError) as exc:
        errors.append(str(exc) if isinstance(exc, ValueError) else 'cannot read citation tree')
    print('citations: %s/%s resolve' % (resolved, total))
    for error in errors:
        print('decision links: REFUSED (%s)' % error, file=sys.stderr)
    return not errors


def main():
    payload = sys.stdin.buffer.read()
    root = subprocess.check_output(['git', 'rev-parse', '--show-toplevel']).decode().strip()
    previous = Path(__file__).absolute().with_name('pre-commit.gars-previous')
    failed = False
    if previous.exists() or previous.is_symlink():
        try:
            code = subprocess.run([str(previous)] + sys.argv[1:], cwd=root,
                                  input=payload).returncode
            failed = code != 0
        except OSError as exc:
            print('pre-commit: previous hook could not run: %s' % exc, file=sys.stderr)
            failed = True
    clean = scan(root, payload)
    links = decision_links(root, staged=True)
    failed = failed or not clean or not links
    print('pre-commit: REFUSED' if failed else 'pre-commit: passed')
    return 1 if failed else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError) as exc:
        print('pre-commit: REFUSED (%s)' % exc, file=sys.stderr)
        sys.exit(1)
