{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/_system/guard_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/_system/session_state.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(_system/*)",
      "Edit(_system/**/*)",
      "Edit(_references/*)",
      "Edit(_references/**/*)",
      "Edit(_templates/*)",
      "Edit(_templates/**/*)",
      "Edit(.claude/*)",
      "Edit(.claude/**/*)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(CONTEXT.md)",
      "Edit(0*/CONTEXT.md)",
      "Edit(0*/**/CONTEXT.md)",
      "Edit(../.gars-approvals/*)",
      "Edit(../.githooks/*)",
      "Edit(../.github/*)",
      "Edit(../.gitlab-ci.yml)",
      "Edit(../docs/decisions/*)",
      "Edit(../tests/fixtures/*)",
      "Edit(../evals/*/fixtures/*)",
      "Edit(../evals/*/test-fixtures/*)",
      "Edit(../benchmarks/holdout/*)",
      "Edit(tests/fixtures/*)",
      "Edit(projects/_index.md)",
      "Edit(projects/*/.gars_submissions)",
      "Edit(projects/*/.gars_submissions/*)",
      "Edit(projects/*/.gars_local_jobs)",
      "Edit(projects/*/.gars_local_jobs/*)",
      "Edit(projects/*/02_bioinformatics/*/run/.gars_run_complete)",
      "Edit(projects/*/02_bioinformatics/*/run/*)",
      "Edit(projects/*/02_bioinformatics/*/run/**/*)",
      "Edit(projects/*/02_bioinformatics/*/submit.sh.local.exit)",
      "Edit(projects/*/02_bioinformatics/*/reproducibility/manifest.json)",
      "Edit(projects/*/02_bioinformatics/*/submit.sh)",
      "Edit(projects/*/02_bioinformatics/*/params.yaml)",
      "Edit(projects/*/.STATUS.lock)",
      "Edit(projects/*/STATUS)",
      "Edit(projects/*/00_data/*/files.csv)",
      "Edit(projects/*/pilot/*)",
      "Edit(projects/*/00_data/dataset.tsv)",
      "Edit(data_sources.tsv)",
      "Edit(projects/*/01_samplesheets/*)",
      "Edit(projects/*/03_custom_analysis/*/PLAN.md.approved)",
      "WebSearch",
      "WebFetch",
      "Edit(projects/*/03_custom_analysis/*/run/*)",
      "Edit(projects/*/03_custom_analysis/*/run/**/*)",
      "Edit(projects/*/03_custom_analysis/*/.gars_submissions.jsonl)"
    ]
  }
}
