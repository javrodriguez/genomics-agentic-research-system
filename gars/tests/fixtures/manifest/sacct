#!/usr/bin/env python3
"""Synthetic scheduler accounting; no cluster or workload is contacted."""
import sys
if '--format=Elapsed,MaxRSS,AllocCPUS' in sys.argv:
    job = sys.argv[sys.argv.index('-j') + 1]
    print('00:01:00|2048K|4|' if job.endswith('.batch') else '00:01:00||4|')
elif '--format=Start' in sys.argv:
    print('2026-09-23T12:00:00')
else:
    print('COMPLETED|0:0')
