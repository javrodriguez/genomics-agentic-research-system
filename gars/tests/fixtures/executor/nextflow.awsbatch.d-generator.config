// Executor settings for AWS Batch. GENERATED by gars-demo/scripts/gen_executor_config.sh.
//
// FIXTURE (GARS decision 0251): the shape a generator must write to be admitted by
// GARS's check_groovy against _templates/config/nextflow.awsbatch.config. Its comments,
// spacing and site values differ from the template's; its grammar does not. The values are
// placeholders, never a real queue, region or install path.
//
// Same contract as nextflow.slurm.config: **no `params` in any form.** The wrapper rejects
// such a config so its audited parameter surface cannot be bypassed. Executor and process
// settings are the permitted use.

process {
    executor = "awsbatch"
    queue    = 'placeholder-launchpad-queue'

    // Clamp every nf-core resource label to what this venue's instances can actually host
    // (largest type: m5.xlarge, 4 vCPU / 16 GB).
    resourceLimits = [cpus: 4, memory: 14.GB, time: 8.h]

    // The job tag; the take and a rehearsal differ only in this value.
    resourceLabels = [goal: 'gars-launch-pad']

    // Same retry family as the slurm config, plus null: when AWS reclaims the HOST the task
    // never reports an exit status at all. maxRetries still bounds it.
    errorStrategy = { (task.exitStatus == null || task.exitStatus in ((130..145) + 104)) ? "retry" : "finish" }
    maxRetries    = 3
}

aws {
    region = 'zz-test-1'
    batch {
        // terraform output batch_cli_path, installed on every instance.
        cliPath = '/opt/nf-tools/bin/aws'
        // Spot reclamation is the venue's normal weather, not an error.
        maxSpotAttempts = 5
        maxParallelTransfers = 4
        maxTransferAttempts  = 3
    }
}

executor {
    queueSize       = 20
    submitRateLimit = "10/1min"
}

trace {
    enabled = true
    file = "pipeline_info/gars_trace.txt"
    overwrite = true
    fields = "task_id,hash,native_id,process,name,status,exit,container,start,complete,realtime,%cpu,rss,cpus"
}
