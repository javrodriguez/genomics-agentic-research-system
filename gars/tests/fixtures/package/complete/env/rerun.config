// Generated by package_run.py render. Every line names its source.
// The re-run machine class (4 CPUs, 16 GB, every process local, in Docker) is this
// package's own setting (decision 0281), not a run record.
executor {
    name   = 'local'
    cpus   = 4
    memory = 14.GB
}

process {
    // recorded at run: resourceLimits of env/run-executor.config, the run's own clamp
    resourceLimits = [cpus: 4, memory: 14.GB, time: 8.h]
    // recorded at run: the image the trace names for this process (tag; digest not recorded)
    withName: 'NFCORE_ATACSEQ:ATACSEQ:FASTQ_ALIGN_BWA:BWA_MEM' { container = 'quay.io/biocontainers/bwa:0.7.17--hed695b0_7' }
    // recorded at run: the image the trace names for this process (tag; digest not recorded)
    withName: 'NFCORE_ATACSEQ:ATACSEQ:MULTIQC' { container = 'quay.io/biocontainers/multiqc:1.13--pyhdfd78af_0' }
}
