// Executor settings for AWS Batch, passed to the wrapper via --nextflow-config (decision 0251).
//
// The venue: Nextflow's head runs where GARS runs (the `local` backend, decision 0039) and every
// pipeline process is its own AWS Batch job. A project's _config/nextflow.awsbatch.config is
// admitted only as an exact rendering of this file: its bytes, comments and spacing included,
// with each of its three slots (the queue, the goal job tag and the region) replaced by a value
// its validator admits. Any other byte is refused. The cliPath is fixed: the demo's terraform
// defines one install path for every host.
//
// Must define no `params` in any form; the wrapper rejects such configs so its audited
// parameter surface cannot be bypassed. Executor and process settings are the permitted use.

process {
    executor = "awsbatch"
    queue    = 'gars-demo-v2-launchpad-queue'

    // Clamp every nf-core resource label to what the venue's largest instance type can host
    // (m5.xlarge, 4 vCPU / 16 GB). Without it a real run asks for label-sized resources, up to
    // 12 cpus / 72 GB, and the job sits unschedulable with only a warning in the head's log.
    resourceLimits = [ cpus: 4, memory: 14.GB, time: 8.h ]

    // The one AWS Batch job tag, always present. Its value tells one run from another in cost
    // allocation (a rehearsal from a take differs only here).
    resourceLabels = [ goal: 'rehearsal' ]

    // The Slurm retry family (130..145 is the SIGTERM/SIGKILL range, 104 a common transient),
    // plus a null exit: when AWS reclaims the HOST the task reports no exit status at all, and
    // an exitStatus-only rule lets the whole pipeline die mid-run. maxRetries still bounds it.
    // Both outcomes are fixed, never slots.
    errorStrategy = { (task.exitStatus == null || task.exitStatus in ((130..145) + 104)) ? "retry" : "finish" }
    maxRetries    = 3
}

aws {
    region = 'us-east-1'
    batch {
        // The AWS CLI installed on every Batch host and mounted into every task container. It
        // must equal the hosts' install path exactly, or every task dies at staging with a
        // misleading "command not found"; on EC2 the plugin demands a path ending /bin/aws.
        cliPath = '/opt/nf-tools/bin/aws'

        // Spot reclamation is the venue's normal weather, not an error: Nextflow resubmits a
        // job whose host was taken, up to this many times, before errorStrategy sees it.
        maxSpotAttempts = 5

        maxParallelTransfers = 4
        maxTransferAttempts  = 3
    }
}

executor {
    queueSize       = 20
    submitRateLimit = "10/1min"
}

// Read by collect's manifest (container per process, start and complete) and by the launch
// pad (native_id, the Batch job id; exit): fixed file and fields. This scope replaces nf-core's own.
trace {
    enabled   = true
    file      = "pipeline_info/gars_trace.txt"
    overwrite = true
    fields    = "task_id,hash,native_id,process,name,status,exit,container,start,complete,realtime,%cpu,rss,cpus"
}
